package views

import (
	"fmt"

	"github.com/ThatAdwaithGuy/req/db/query"
)

templ FormsGridPage(forms []query.Form) {
	@Layout("CRM Terminal - Forms", formsGrid(forms))
}

templ formsGrid(forms []query.Form) {
	<div class="max-w-6xl mx-auto">
		<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
			<div>
				<h3 class="font-semibold text-lg text-slate-200">Form Directory</h3>
				<p class="text-xs text-slate-400 mt-1">Select a form to enter records.</p>
			</div>
			<a
				href="/create_form"
				class="inline-flex items-center justify-center px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded text-sm font-medium transition shadow-sm"
			>
				+ Add Form
			</a>
		</div>
		if len(forms) == 0 {
			<div class="bg-slate-950 border border-slate-800 rounded-lg px-6 py-12 text-center text-sm text-slate-500">
				No forms found. Click "+ Add Form" to create your first one.
			</div>
		} else {
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
				for _, form := range forms {
					@FormCard(form)
				}
			</div>
		}
	</div>
}

// A single clickable card for a form; loads field/row counts via htmx once visible
templ FormCard(form query.Form) {
	<a
		href={ templ.URL("/enter_forms/" + form.FormName) }
		class="group block rounded-xl border border-slate-800 bg-slate-950 hover:border-indigo-500/50 hover:bg-slate-900/60 transition p-5 shadow-lg hover:shadow-indigo-900/20"
	>
		<div class="flex items-start justify-between mb-4">
			<span class="h-2 w-2 rounded-full bg-indigo-500"></span>
			if form.Enterable.Bool {
				<span class="text-[10px] uppercase tracking-wider font-bold text-emerald-400 bg-emerald-400/10 px-2 py-0.5 rounded">
					Active
				</span>
			} else {
				<span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 bg-slate-500/10 px-2 py-0.5 rounded">
					Inactive
				</span>
			}
		</div>
		<h4 class="text-xl font-bold text-slate-100 group-hover:text-indigo-400 transition truncate">
			{ form.FormName }
		</h4>
		<div
			hx-get={ fmt.Sprintf("/api/get_form_stats?form=%s", form.FormName) }
			hx-trigger="revealed"
			hx-swap="innerHTML"
			class="mt-4"
		>
			<div class="grid grid-cols-2 gap-3 animate-pulse">
				<div class="h-10 bg-slate-800/60 rounded"></div>
				<div class="h-10 bg-slate-800/60 rounded"></div>
			</div>
		</div>
	</a>
}

// Partial returned by GET /api/get_form_stats?form=... to swap into the card
templ FormStatsPartial(fieldCount int, rowCount int) {
	<div class="grid grid-cols-2 gap-3">
		<div class="rounded bg-slate-900/60 border border-slate-800/50 px-3 py-2">
			<div class="text-lg font-mono font-semibold text-slate-200">
				{ fmt.Sprintf("%d", fieldCount) }
			</div>
			<div class="text-[10px] uppercase tracking-wider text-slate-500">
				Fields
			</div>
		</div>
		<div class="rounded bg-slate-900/60 border border-slate-800/50 px-3 py-2">
			<div class="text-lg font-mono font-semibold text-slate-200">
				{ fmt.Sprintf("%d", rowCount) }
			</div>
			<div class="text-[10px] uppercase tracking-wider text-slate-500">
				Rows
			</div>
		</div>
	</div>
}
