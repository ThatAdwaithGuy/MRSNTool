package templates

// Layout wrapper to keep HTML structure consistent
templ Layout(title string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
		<script src="https://unpkg.com/htmx.org@1.9.10"></script>
	</head>
	<body class="bg-slate-900 text-slate-100 font-sans flex h-screen overflow-hidden">
		<aside class="w-64 bg-slate-950 border-r border-slate-800 flex flex-col justify-between p-4">
			<div>
				<div class="flex items-center gap-3 px-2 py-4 border-b border-slate-800 mb-6">
					<div class="h-8 w-8 rounded bg-indigo-600 flex items-center justify-center font-bold text-lg">Ω</div>
					<span class="font-semibold tracking-wider text-lg">CRM Terminal</span>
				</div>
				<nav class="space-y-1">
					<a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded bg-indigo-600/20 text-indigo-400 font-medium">
						<span>Dashboard</span>
					</a>
					<a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded hover:bg-slate-900 text-slate-400 hover:text-slate-200 transition">
						<span>Customers</span>
					</a>
					<a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded hover:bg-slate-900 text-slate-400 hover:text-slate-200 transition">
						<span>Analytics</span>
					</a>
					<a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded hover:bg-slate-900 text-slate-400 hover:text-slate-200 transition">
						<span>Settings</span>
					</a>
				</nav>
			</div>
			<div class="p-2 text-xs text-slate-500 border-t border-slate-800">
				v1.0.0 • Connected
			</div>
		</aside>

		<main class="flex-1 flex flex-col overflow-y-auto">
			<header class="h-16 border-b border-slate-800 flex items-center justify-between px-8 bg-slate-900/50 backdrop-blur">
				<h1 class="text-xl font-semibold">System Overview</h1>
				<div class="flex items-center gap-4">
					<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
						System Live
					</span>
					<div class="h-8 w-8 rounded-full bg-slate-800 flex items-center justify-center text-sm border border-slate-700">
						A
					</div>
				</div>
			</header>

			<div class="p-8 space-y-8 max-w-7xl w-full mx-auto">
				@body
			</div>
		</main>
	</body>
	</html>
}

// Main Dashboard view component
templ Index() {
	@Layout("CRM Terminal - Home", DashboardContent())
}

// Internal metric/content grid
templ DashboardContent() {
	<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
		<div class="p-6 bg-slate-950 border border-slate-800 rounded-lg">
			<p class="text-sm font-medium text-slate-400 uppercase tracking-wider">Total Active Customers</p>
			<p class="text-3xl font-bold mt-2 text-indigo-400">1,248</p>
			<span class="text-xs text-emerald-400 mt-1 block">↑ 12% from last month</span>
		</div>
		<div class="p-6 bg-slate-950 border border-slate-800 rounded-lg">
			<p class="text-sm font-medium text-slate-400 uppercase tracking-wider">New Signups (Today)</p>
			<p class="text-3xl font-bold mt-2 text-emerald-400">34</p>
			<span class="text-xs text-slate-500 mt-1 block">Steady pace</span>
		</div>
		<div class="p-6 bg-slate-950 border border-slate-800 rounded-lg">
			<p class="text-sm font-medium text-slate-400 uppercase tracking-wider">Pending Support Tickets</p>
			<p class="text-3xl font-bold mt-2 text-amber-500">7</p>
			<span class="text-xs text-amber-400/80 mt-1 block">Requires attention</span>
		</div>
	</div>

	<div class="bg-slate-950 border border-slate-800 rounded-lg overflow-hidden">
		<div class="px-6 py-4 border-b border-slate-800 flex justify-between items-center">
			<h3 class="font-semibold text-slate-200">Recent Customer Activity</h3>
			<button class="text-xs text-indigo-400 hover:underline">View All</button>
		</div>
		<div class="overflow-x-auto">
			<table class="w-full text-left text-sm text-slate-400">
				<thead class="bg-slate-900/50 text-slate-300 text-xs uppercase font-medium">
					<tr>
						<th class="px-6 py-3">Customer</th>
						<th class="px-6 py-3">Action</th>
						<th class="px-6 py-3">Status</th>
						<th class="px-6 py-3 text-right">Time</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-800/60">
					<tr class="hover:bg-slate-900/40 transition">
						<td class="px-6 py-4 font-medium text-slate-200">Alex Rivera</td>
						<td class="px-6 py-4">Updated billing profile</td>
						<td class="px-6 py-4">
							<span class="px-2 py-0.5 rounded text-xs bg-emerald-500/10 text-emerald-400">Success</span>
						</td>
						<td class="px-6 py-4 text-right text-xs">2 mins ago</td>
					</tr>
					<tr class="hover:bg-slate-900/40 transition">
						<td class="px-6 py-4 font-medium text-slate-200">Morgan Chen</td>
						<td class="px-6 py-4">Created new account</td>
						<td class="px-6 py-4">
							<span class="px-2 py-0.5 rounded text-xs bg-indigo-500/10 text-indigo-400">New</span>
						</td>
						<td class="px-6 py-4 text-right text-xs">14 mins ago</td>
					</tr>
					<tr class="hover:bg-slate-900/40 transition">
						<td class="px-6 py-4 font-medium text-slate-200">Sarah Jenkins</td>
						<td class="px-6 py-4">Password reset requested</td>
						<td class="px-6 py-4">
							<span class="px-2 py-0.5 rounded text-xs bg-amber-500/10 text-amber-400">Pending</span>
						</td>
						<td class="px-6 py-4 text-right text-xs">1 hr ago</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
}
