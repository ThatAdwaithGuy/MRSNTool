package views

import (
	"github.com/ThatAdwaithGuy/req/db/query"
	"strconv"
)

// View wrapper rendering the forms list inside the CRM Layout
templ FormsListPage(formNames []string) {
	@Layout("CRM Terminal - Form Configurations", formNamesList(formNames))
}

// Interactive accordion list for unique form names
templ formNamesList(formNames []string) {
	<div class="max-w-4xl mx-auto bg-slate-950 border border-slate-800 rounded-lg overflow-hidden shadow-xl">
		<div class="px-6 py-4 border-b border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
			<div>
				<h3 class="font-semibold text-lg text-slate-200">Registered Forms</h3>
				<p class="text-xs text-slate-400 mt-1">Select a form name to expand and view its fields.</p>
			</div>
			<div>
				<a
					href="/create_form"
					class="inline-flex items-center justify-center px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded text-sm font-medium transition shadow-sm"
				>
					+ Add Form
				</a>
			</div>
		</div>
		<div class="divide-y divide-slate-800/50">
			if len(formNames) == 0 {
				<div class="px-6 py-12 text-center text-sm text-slate-500">
					No forms found. Click "+ Add Form" to create your first one.
				</div>
			} else {
				for _, name := range formNames {
					<details class="group [&_summary::-webkit-details-marker]:hidden">
						<summary
							class="flex items-center justify-between px-6 py-4 cursor-pointer hover:bg-slate-900/30 transition text-sm text-slate-200 font-medium tracking-wide"
						>
							<span class="flex items-center gap-3">
								<span class="h-2 w-2 rounded-full bg-indigo-500"></span>
								{ name }
							</span>
							<span class="text-slate-500 group-open:-rotate-180 transition-transform duration-200">
								<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
								</svg>
							</span>
						</summary>
						<div
							class="bg-slate-900/40 border-t border-slate-800/50 p-4"
							hx-get={ "/api/get_form_designs?form=" + name }
							hx-trigger="click from:closest details once"
							hx-swap="innerHTML"
						>
							<div class="text-center py-6 text-sm text-slate-500 animate-pulse">
								Loading configuration fields for { name }...
							</div>
						</div>
					</details>
				}
			}
		</div>
		if len(formNames) > 0 {
			<div class="px-6 py-3 bg-slate-950 border-t border-slate-800 text-xs text-slate-500 text-right">
				Showing { strconv.Itoa(len(formNames)) } unique forms
			</div>
		}
	</div>
}

templ FormEntriesTable(designs []query.GetDesignByFormNameRow) {
	if len(designs) == 0 {
		<div class="text-sm text-slate-500 py-4 text-center italic">
			No fields configured for this form yet.
		</div>
	} else {
		<table class="w-full text-left border-collapse">
			<thead>
				<tr class="text-slate-500 text-xs tracking-wider uppercase border-b border-slate-800/50">
					<th class="pb-2 font-medium w-16">ID</th>
					<th class="pb-2 font-medium">Label</th>
					<th class="pb-2 font-medium">Type</th>
					<th class="pb-2 font-medium text-center">Req</th>
					<th class="pb-2 font-medium text-right">Seq</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-slate-800/30">
				for _, d := range designs {
					<tr class="hover:bg-slate-800/20 transition text-sm text-slate-300">
						<td class="py-2 text-xs font-mono text-slate-500">
							#{ strconv.FormatInt(int64(d.ID), 10) }
						</td>
						<td class="py-2 text-slate-200">
							{ d.LabelName }
						</td>
						<td class="py-2">
							<span class="text-xs font-mono text-indigo-400">
								{ d.DataType }
							</span>
						</td>
						<td class="py-2 text-center">
							if d.IsMandatory {
								<span class="text-amber-400 text-xs font-bold">*</span>
							} else {
								<span class="text-slate-600 text-xs">-</span>
							}
						</td>
						<td class="py-2 text-right font-mono text-slate-400">
							{ strconv.FormatInt(int64(d.Sequence), 10) }
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}
